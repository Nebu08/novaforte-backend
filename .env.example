# Puerto en el que corre el servidor backend (por defecto: 4000)
PORT=4000

# API Key de Resend (para envío de correos)
RESEND_API_KEY=re_your_api_key_here

# Dirección de correo origen (Remitente en Resend)
EMAIL_FROM=NOVAFORTE <onboarding@resend.dev>

# Dirección de correo destino (Destinatario que recibe las cotizaciones/contacto)
EMAIL_TO=novafortesas@gmail.com

# Configuración SMTP histórica de Gmail (opcional si usas SMTP en vez de Resend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=novafortewebsite@gmail.com
EMAIL_PASS=your_gmail_app_password_here
