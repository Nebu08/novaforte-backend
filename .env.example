# ============================================================
#  BACKEND — Variables de entorno (.env.example)
#  Copia este archivo como `.env` y rellena los valores reales.
#  NUNCA subas el `.env` real al repositorio.
# ============================================================

# Entorno: "development" o "production"
# En producción: deshabilita logs verbosos, activa HSTS, restringe CORS a vercel preview, etc.
NODE_ENV=development

# Puerto en el que corre el servidor backend (por defecto: 4000)
PORT=4000

# ── EMAIL (RESEND) ───────────────────────────────────────────
# API Key de Resend (para envío de correos)
RESEND_API_KEY=re_your_api_key_here

# Dirección de correo origen (Remitente en Resend)
EMAIL_FROM=NOVAFORTE <onboarding@resend.dev>

# Dirección de correo destino (Destinatario que recibe las cotizaciones/contacto)
EMAIL_TO=novafortesas@gmail.com

# ── SEGURIDAD ────────────────────────────────────────────────
# API Key interna para proteger el endpoint POST /api/models (subida de modelos 3D)
# Genera un valor largo y aleatorio: openssl rand -hex 32
MODELS_API_KEY=cambia_esto_por_un_valor_secreto_largo

# Orígenes permitidos adicionales (separados por coma, sin espacios)
# ALLOWED_ORIGINS=https://mi-preview.vercel.app

# ── LEGACY SMTP (NO USAR — mantener solo como referencia) ───
# Si usabas Gmail SMTP antes de migrar a Resend:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=novafortewebsite@gmail.com
# EMAIL_PASS=ROTAR_ESTA_CLAVE_SI_ESTUVO_EXPUESTA
